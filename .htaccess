ErrorDocument 401 /errors/401/
ErrorDocument 403 /errors/403/
ErrorDocument 404 /errors/404/
ErrorDocument 500 /errors/500/
ErrorDocument 501 /errors/501/
ErrorDocument 503 /errors/503/

# Block configuration, credentials, hidden files, dumps and backups (in subfolders too)
<FilesMatch "^\.|^(variables|credentials)([-.].*)?\.php$|\.(sql|sql\.gz|log|bak|old|swp|ini|env)$|^composer\.(json|lock)$|~$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Composer libraries must not be reachable from the browser
RedirectMatch 404 ^/vendor(/|$)

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Redirects
<IfModule mod_rewrite.c>
    RewriteEngine On
    # fucina.saveriomorelli.com shows Fucina (projects/fucina) at the root of its own address,
    # when the subdomain points to this web space; www.saveriomorelli.com/projects/fucina/ keeps working too
    RewriteCond %{HTTP_HOST} ^fucina\.saveriomorelli\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://fucina.saveriomorelli.com%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^fucina\.saveriomorelli\.com$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/projects/fucina/$1 -d
    RewriteRule ^(.*[^/])$ https://fucina.saveriomorelli.com/$1/ [L,R=301]
    RewriteCond %{HTTP_HOST} ^fucina\.saveriomorelli\.com$ [NC]
    RewriteCond %{REQUEST_URI} !^/(projects/fucina|errors)/
    RewriteRule ^(.*)$ projects/fucina/$1 [L]
    RewriteRule ^contact/?$ /contact-me/ [L,R=301]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*[^/])$ %{REQUEST_URI}/ [L,R=301]
</IfModule>
