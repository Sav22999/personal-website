# Moved to www.illerom.eu (active only while projects/.illerom-live exists): the pages go there through ../illerom.php.
# Scripts, images and API stay, for the tabs still open and for the Android apps published before the move: those only
# accept this address (a redirect would throw them out to the browser), so inside them everything goes on as before.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/projects/.illerom-live -f
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_URI} !(/api/|^/errors/)
    RewriteCond %{HTTP_USER_AGENT} !App/Android
    RewriteCond %{HTTP_USER_AGENT} !;\ wv\) [OR]
    RewriteCond %{HTTP_USER_AGENT} (FBAN|FBAV|FB_IAB|Instagram|LinkedInApp|Snapchat|TikTok|Pinterest)
    RewriteCond %{HTTP:Sec-Fetch-Mode}:%{REQUEST_URI} ^navigate: [OR]
    RewriteCond %{HTTP:Sec-Fetch-Mode}:%{REQUEST_URI} ^:(.*/|.*\.html|.*/(index|subscribe|unsubscribe|terms|certificate|verify)\.php|/projects/[a-z0-9-]+)$
    RewriteRule ^ /projects/illerom.php [L]
</IfModule>

# Fucina (web app)
Options -Indexes
DirectoryIndex index.html

# Block credentials, samples, SQL, docs and hidden files anywhere in this folder
<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak|jks|keystore|properties|gradle|kts)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries, installer data and tools are not reachable from the browser,
# both at www.saveriomorelli.com/projects/fucina/ and at fucina.saveriomorelli.com/
RedirectMatch 404 ^(/projects/fucina)?/(lib|install|tools|android)(/|$)

# Fucina can be shown inside its own subdomain (fucina.saveriomorelli.com, also when it only frames this folder)
# and nowhere else: frame-ancestors replaces the X-Frame-Options: SAMEORIGIN of the main site, which would block it
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Frame-Options
  Header always unset X-Frame-Options
  Header set Content-Security-Policy "frame-ancestors 'self' https://fucina.saveriomorelli.com http://fucina.saveriomorelli.com https://www.saveriomorelli.com"
</IfModule>

# Force HTTPS (the session cookie is marked Secure)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # A subfolder without its final slash: add it staying on https (Apache's own slash would answer http:// behind
  # Aruba's proxy). The folder of Fucina itself is handled by the RedirectMatch of the main .htaccess.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
