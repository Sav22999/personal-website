# Rendicontazione Ore (Portale Papà)
Options -Indexes
DirectoryIndex index.php

# Block credentials, database files, sql dumps and protected directories
<FilesMatch "(^\.|^credentials.*\.php$|\.(sqlite|db|sql|log|bak|md)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Internal libraries and data storage are not reachable from the browser
RedirectMatch 404 ^/projects/dad/rendicontazione/(lib|data)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
