# Copy this file to keystore.properties (git-ignored) and fill in the data of YOUR upload key.
# Create the key from Android Studio: Build > Generate Signed App Bundle / APK > Create new...
# Keep the .jks file and these passwords safe and private: without them you cannot update the app.
storeFile=/percorso/assoluto/foodtrack-upload.jks
storePassword=PASSWORD_DEL_KEYSTORE
keyAlias=foodtrack
keyPassword=PASSWORD_DELLA_CHIAVE
