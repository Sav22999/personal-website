# FoodTrack (web app + admin portal)
Options -Indexes
DirectoryIndex index.html

# Block credentials, samples, SQL, docs and hidden files anywhere in this folder
<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak|jks|keystore|properties|gradle|kts)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries, installer data, tools and the Android Studio project are not reachable from the browser
RedirectMatch 404 ^/projects/foodtrack/(lib|install|tools|android)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # The camera is needed by the barcode scanner (the main site disables it)
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

# Force HTTPS (the session cookie is marked Secure)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
