# SavAccount API: only api/index.php is reachable, and only with the gateway key
Options -Indexes
RedirectMatch 404 ^/projects/savaccount/(lib|tests)(/|$)
<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak|cnf)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ - [F]
</IfModule>
