# OpenNewsletter
Options -Indexes
DirectoryIndex index.php

# Block credentials, samples, SQL, docs and hidden files anywhere in this folder
<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries, installer data and tools are not reachable from the browser
RedirectMatch 404 ^/projects/opennewsletter/(lib|install|tools)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # No X-Frame-Options here: subscribe.php must be embeddable (widget); every page sets its own frame policy
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^widget\.js$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # The site root sends X-Frame-Options SAMEORIGIN everywhere: the widget's page must be embeddable on other sites
  # (subscribe.php sends its own "frame-ancestors *")
  <FilesMatch "^subscribe\.php$">
    Header always unset X-Frame-Options
    Header unset X-Frame-Options
  </FilesMatch>
</IfModule>

# Force HTTPS (the session cookie is marked Secure)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
