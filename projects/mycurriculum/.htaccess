# MyCurriculum
Options -Indexes
DirectoryIndex index.php

# Block credentials, samples, SQL, docs and hidden files anywhere in this folder
<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak|jks|keystore|properties|gradle|kts)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries, installer data and tools are not reachable from the browser
RedirectMatch 404 ^/projects/mycurriculum/(lib|install|tools|android)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # ES modules import each other without a version: the browser asks every time whether they changed (ETag, cheap)
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Force HTTPS (the session cookie is marked Secure)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
